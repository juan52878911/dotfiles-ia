#!/usr/bin/env python3
"""Fake `pi -p --mode json "<prompt>"`: prints Pi-style JSON events.
FAKE_PI_MODE ok (default: session, 2 tool calls, final message) | hang (tools then sleeps forever) | crash (rc 3)
FAKE_PI_ARGV  file where argv is dumped."""
import json, os, sys, time
mode = os.environ.get("FAKE_PI_MODE", "ok")
if os.environ.get("FAKE_PI_ARGV"):
    open(os.environ["FAKE_PI_ARGV"], "w").write(json.dumps(sys.argv[1:]))
out = lambda e: (sys.stdout.write(json.dumps(e) + "\n"), sys.stdout.flush())
if mode == "crash":
    sys.stderr.write("boom\n"); sys.exit(3)
out({"type": "session", "id": "pi-sess-1"})
out({"type": "agent_start"})
for i, cmd in enumerate(("ls", "cat main.py")):
    out({"type": "turn_start"})
    out({"type": "tool_execution_start", "toolName": "bash", "args": {"command": cmd}})
    out({"type": "tool_execution_end", "toolName": "bash", "isError": False})
    out({"type": "turn_end"})
if mode == "hang":
    time.sleep(120)
msg = {"role": "assistant", "model": "MiniMax-M3", "content": [{"type": "text", "text": "all done"}],
       "usage": {"cost": {"total": 0.002}}}
out({"type": "message_end", "message": msg})
out({"type": "agent_end", "messages": [msg]})
