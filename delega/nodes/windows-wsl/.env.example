# Copy to .env next to 2-wsl.sh and fill in. .env is git-ignored; never commit real values.
# Public SSH key of the orchestrator machine (the one that will connect to this node).
ORCH_SSH_PUBKEY="ssh-ed25519 AAAA... orchestrator"
# Git identity for commits made on this node.
GIT_USER_NAME="Alex Doe"
GIT_USER_EMAIL="alex@example.com"
# Domain the Claude account on this node must belong to (checked at the end).
EXPECT_EMAIL_DOMAIN="example.com"
# Directory under $HOME where delega keeps its work (must match `workdir` in the node config).
DELEGA_WORKDIR="delega"
# Optional WireGuard tunnel to a hub: leave WG_IP empty to skip it.
WG_IP=""
HUB_PUB=""
HUB_ENDPOINT=""
WG_ALLOWED="10.10.10.0/24"
